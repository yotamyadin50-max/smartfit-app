# ── OpenRouter AI (server-side only — never exposed to the browser) ───────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Supabase (browser-safe — VITE_ prefix exposes these to the client) ────────
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy "Project URL" and "anon public" key below
# 4. Run supabase/schema.sql once in the SQL Editor to create the tables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
